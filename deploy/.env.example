# ---------------------------------------------------------------------------
# 电商售后管家 · 环境变量模板（Spec §17.5）
# 使用：cp deploy/.env.example deploy/.env 后按需修改；.env 已被 .gitignore 忽略。
# 字段与 app/common/config.py 的 Settings 一一对应（单测守护）。
# ---------------------------------------------------------------------------

# ---- 应用 ----
APP_NAME=aftersales-agent
APP_VERSION=0.1.0
APP_ENV=dev
RELEASE_CHANNEL=dev
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json
DOCS_ENABLED=true
SHUTDOWN_DRAIN_SECONDS=3
# JSON 数组；为空表示不启用 CORS（同源部署无需开启）
CORS_ALLOW_ORIGINS=[]

# ---- 依赖组件 ----
DATABASE_URL=mysql+aiomysql://aftersales:aftersales@127.0.0.1:3306/aftersales?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
CHROMA_URL=http://127.0.0.1:8100
MQ_ENABLED=false
MQ_NAMESERVER=127.0.0.1:9876
MQ_CONSUMER_GROUP=aftersales-dev
MQ_TOPIC_TICKET_CREATE=AS_TICKET_CREATE

# ---- 探针 ----
READY_TIMEOUT_MS=2000

# ---- 鉴权（dev/test 用 HS256；staging/prod 必须 RS256 + 公钥文件）----
JWT_ALGORITHM=HS256
JWT_HS256_SECRET=dev-only-insecure-hs256-secret-change-me
JWT_PUBLIC_KEY_PATH=
JWT_PRIVATE_KEY_PATH=
JWT_ISSUER=aftersales-agent
JWT_TTL_SECONDS=3600

# ---- LLM（M1）----
# mock = 录制回放（CI/离线）；openai = OpenAI 兼容网关（DeepSeek 亦兼容）
LLM_PROVIDER=mock
LLM_MODEL=deepseek-flash
LLM_FALLBACK_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
# key 只放文件（建议 .secrets/llm_key.txt，已被 gitignore）；支持纯密钥或 LLM_KEY=sk-... 写法
LLM_API_KEY_FILE=
LLM_TIMEOUT_MS=15000
LLM_MAX_CONCURRENCY=8
LLM_MAX_OUTPUT_TOKENS=800
# 推理模型档位：low 显著降低首字延迟；不支持的模型可留空
LLM_REASONING_EFFORT=low
LLM_RETRY=1
LLM_MOCK_CASSETTE_DIR=evals/cassettes

# ---- Embedding（M1）----
# hash = 确定性哈希（CI/单测，不代表检索质量）；fastembed = 本地 bge-small-zh；api = 远程
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=256
EMBEDDING_API_URL=
# 本机直连 huggingface.co 不通时必须走镜像（模型 ~100MB，仅首次下载）
HF_ENDPOINT=https://hf-mirror.com

# ---- RAG 检索 ----
RAG_TOP1_THRESHOLD=0.75
RAG_LOW_THRESHOLD=0.55
RAG_TOP_K_VECTOR=20
RAG_TOP_K_KEYWORD=20
RAG_TOP_K_FUSED=10
RAG_TOP_K_FINAL=5
RAG_RRF_K=60
# none = 保持 RRF 顺序（CI/离线默认）；llm = 对 Top10 用模型重排（多一次调用）
RERANK_PROVIDER=none
KEYWORD_BACKEND=mysql
CORPUS_DIR=seeds/corpus

# ---- 缓存与会话 ----
RAG_CACHE_TTL_SEC=300
FAQ_CACHE_TTL_SEC=1800
FACT_CACHE_TTL_SEC=600
SESSION_TTL_HOURS=24
SESSION_WINDOW_TURNS=10
PROMPT_CACHE_TTL_SEC=60

# ---- SSE / Trace ----
SSE_BUFFER_TTL_SEC=300
SSE_BUFFER_MAX_FRAMES=500
TRACE_SPAN_ENABLED=true

# ---- 业务开关 ----
APPROVAL_THRESHOLD_CNY=500
WRITE_ERROR_BREAKER_RATIO=0.5
BREAKER_WINDOW_SEC=60
IDLE_APPROVAL_EXPIRE_HOURS=24
GRAY_PERCENT=0
IDEMPOTENCY_TTL_SEC=86400
USER_RATE_LIMIT_PER_MIN=20

# ---- worker ----
WORKER_HEARTBEAT_INTERVAL_SEC=10
WORKER_HEARTBEAT_TTL_SEC=30

# ---- 运维 ----
ALERT_WEBHOOK_URL_FILE=

# ---- compose 专用（非 Settings 字段）----
API_PORT=8000
NGINX_PORT=8080
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=aftersales
MYSQL_USER=aftersales
MYSQL_PASSWORD=aftersales
REDIS_PORT=6379
CHROMA_PORT=8100
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
LOKI_PORT=3100
MQ_NAMESRV_PORT=9876
MQ_BROKER_PORT=10911

# ---------------------------------------------------------------------------
# 本地/预发接真实网关时的最小改动（复制到 .env 覆盖）：
# LLM_PROVIDER=openai
# LLM_API_KEY_FILE=.secrets/llm_key.txt
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_DIM=512
#
# 生产（staging/prod）必须换掉默认开发密钥：
# APP_ENV=prod
# RELEASE_CHANNEL=prod
# JWT_ALGORITHM=RS256
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_pub
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_priv
# DATABASE_URL=mysql+aiomysql://user:pass@mysql-primary:3306/aftersales
# REDIS_URL=redis://redis-sentinel:26379/0
# MQ_ENABLED=true
# LLM_API_KEY_FILE=/run/secrets/llm_key
# ALERT_WEBHOOK_URL_FILE=/run/secrets/alert_webhook
# ---------------------------------------------------------------------------
