{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "对话 P95 / P50 耗时",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(chat_latency_seconds_bucket[5m])) by (le))", "legendFormat": "P95", "refId": "A"},
        {"expr": "histogram_quantile(0.50, sum(rate(chat_latency_seconds_bucket[5m])) by (le))", "legendFormat": "P50", "refId": "B"}
      ]
    },
    {
      "title": "首片段耗时 P95（按生成/兜底）",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(chat_first_token_seconds_bucket[5m])) by (le, mode))", "legendFormat": "{{mode}}", "refId": "A"}
      ]
    },
    {
      "title": "HTTP 5xx 比例",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 9},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [
        {"expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)", "legendFormat": "5xx", "refId": "A"}
      ]
    },
    {
      "title": "检索缓存命中率",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 9},
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1, "min": 0}, "overrides": []},
      "targets": [{"expr": "rag_cache_hit_ratio", "legendFormat": "hit ratio", "refId": "A"}]
    },
    {
      "title": "无引用被拦截（应为 0）",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 9},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [{"expr": "increase(answer_without_citation_total[1h])", "legendFormat": "1h", "refId": "A"}]
    },
    {
      "title": "LLM token 速率（按节点）",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 17},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {"expr": "sum(rate(llm_tokens_total[5m])) by (node)", "legendFormat": "{{node}}", "refId": "A"}
      ]
    },
    {
      "title": "对话请求量 / 错误量",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 17},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {"expr": "sum(rate(http_requests_total{path=\"/api/v1/chat/stream\"}[5m]))", "legendFormat": "chat rps", "refId": "A"},
        {"expr": "sum(rate(http_requests_total{path=\"/api/v1/chat/stream\",status=~\"4..|5..\"}[5m]))", "legendFormat": "chat errors", "refId": "B"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["e-co", "m1", "rag"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "e-co · M1 问答链路",
  "uid": "e-co-m1-rag",
  "version": 1
}
